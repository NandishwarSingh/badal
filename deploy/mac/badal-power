#!/bin/bash
# Keep the Mac reachable as a badal worker at all times.
#
# pmset's `disablesleep` is the only setting that overrides lid-close sleep,
# and it accepts only -a (all power sources). That is what we want here: the
# worker should be claimable whether or not the charger is in.
#
# The consequence is real and deliberate -- an unplugged Mac with the lid shut
# will keep running and will flatten. Plug in, or expect the battery to go.
#
# This runs as a daemon rather than a one-shot pmset because macOS resets
# these across major updates and some power events.
set -u
while true; do
  # Never sleep, on either power source.
  pmset -a disablesleep 1 2>/dev/null
  # Idle sleep off on both; let the display sleep, which costs nothing.
  pmset -c sleep 0 displaysleep 5 disksleep 0 womp 1 2>/dev/null
  pmset -b sleep 0 displaysleep 3 disksleep 0 2>/dev/null
  sleep 300
done
